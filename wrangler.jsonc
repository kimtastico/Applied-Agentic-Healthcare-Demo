{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plainly-medical-explainer",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Static site in ./public; the Worker only runs for /api/* routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Non-secret settings. Secrets (NVIDIA_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_KEY)
  // are set with `npx wrangler secret put <NAME>`, or in .dev.vars for local dev.
  "vars": {
    "NVIDIA_MODEL": "meta/llama-3.3-70b-instruct",
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1"
  },

  // 10 explanations per minute per visitor. Counters are kept in memory by
  // Cloudflare and are not stored or logged.
  "ratelimits": [
    {
      "name": "EXPLAIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Request logs would include visitor IPs; keep them off so we don't track users.
  "observability": { "enabled": false }
}
