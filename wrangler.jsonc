{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plainly-medical-explainer",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Static site in ./public; the Worker only runs for /api/* routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Non-secret settings. Secrets (NVIDIA_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_KEY)
  // are set with `npx wrangler secret put <NAME>`, or in .dev.vars for local dev.
  "vars": {
    // Tried in order: if a model is overloaded, retired, or missing, the next one answers.
    "NVIDIA_MODEL": "nvidia/nemotron-3-ultra-550b-a55b, deepseek-ai/deepseek-v4.1-flash, nvidia/nemotron-3.5-lightning-30b-a3b",
    // "on" = the model thinks before answering (follows the rules better);
    // "off" = faster answers. To cap thinking on models that support it (not Ultra),
    // add "NVIDIA_REASONING_BUDGET": "1024".
    "NVIDIA_REASONING": "off",
    // "on" = a second AI call reviews each new answer against the site's rules and
    // corrects it if needed (slower first search, safer answers); "off" = writer only.
    "NVIDIA_REVIEW": "on",
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1"
  },

  // 10 explanations per minute per visitor. Counters are kept in memory by
  // Cloudflare and are not stored or logged.
  "ratelimits": [
    {
      "name": "EXPLAIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Save the Worker's own error messages (which never contain user text), but not
  // Cloudflare's per-request logs, which would record visitor IPs.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
