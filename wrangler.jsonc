{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plainly-medical-explainer",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Static site in ./public; the Worker only runs for /api/* routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Workers AI: Cloudflare-hosted models, free on the Workers Free plan up to a daily
  // allowance (requests fail, never bill, once it's used up).
  "ai": { "binding": "AI" },

  // Non-secret settings. Secrets (SUPABASE_URL, SUPABASE_SERVICE_KEY, and the optional
  // NVIDIA_API_KEY) are set with `npx wrangler secret put <NAME>`, or in .dev.vars locally.
  "vars": {
    // Tried in order. "@cf/..." models run on Workers AI; others on NVIDIA's free API,
    // kept as a backup because it is often overloaded.
    "WRITER_MODELS": "@cf/meta/llama-3.3-70b-instruct-fp8-fast, nvidia/nemotron-3-ultra-550b-a55b, nvidia/nemotron-3.5-lightning-30b-a3b",
    // Only strong models review: a weak reviewer over-corrects and can make answers worse.
    // A different model family from the writer catches more of the writer's mistakes.
    // If none is available, the answer is shown as "Not yet reviewed" and not saved.
    "REVIEWER_MODELS": "@cf/openai/gpt-oss-120b, nvidia/nemotron-3-ultra-550b-a55b",
    // "on" = a second AI call reviews each new answer against the site's rules and
    // corrects it if needed (slower first search, safer answers); "off" = writer only.
    "AI_REVIEW": "on",
    // NVIDIA models only: "on" = think before answering; "off" = faster. To cap thinking on
    // NVIDIA models that support it (not Ultra), add "NVIDIA_REASONING_BUDGET": "1024".
    "NVIDIA_REASONING": "off",
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1"
  },

  // 10 explanations per minute per visitor. Counters are kept in memory by
  // Cloudflare and are not stored or logged.
  "ratelimits": [
    {
      "name": "EXPLAIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Save the Worker's own error messages (which never contain user text), but not
  // Cloudflare's per-request logs, which would record visitor IPs.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
